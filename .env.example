# Active Environment: 'UAT' (default for development/testing) or 'PRODUCTION'
ENVIRONMENT=UAT

# Data Source Mode: 'mock' (default) or 'real'
DATA_SOURCE=mock

# Microsoft Teams Bot Configuration
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
PORT=3978
DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=false

# Active Directory Configuration (Used only when DATA_SOURCE=real)
AD_LDAP_SERVER=ldap://your-domain-controller.example.com
AD_DOMAIN=YOUR_DOMAIN
AD_BASE_DN=DC=example,DC=com
AD_BIND_USER=bind_user@example.com
AD_BIND_PASSWORD=
